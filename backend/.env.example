APP_NAME=GeoEstate Intelligence API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://geoestate:geoestate@localhost:5432/geoestate
GEOCODING_USER_AGENT=GeoEstate-Intelligence/0.1 (contact: your-email@example.com)
GEOCODING_EMAIL=your-email@example.com
GEOCODING_REQUEST_DELAY_SECONDS=1.1
GEOCODING_TIMEOUT_SECONDS=15
GEOCODING_RETRY_FAILED_CACHE=false
GEOCODING_LOCALITY_ALIASES={"mirkhanpet":"Meerkhanpet","aminpur":"Ameenpur","bhongir":"Bhuvanagiri","appa junction peerancheru":"Peerancheru","yadagirigutta":"Yadadri","shankarpalli":"Shankarpally"}
ENRICHMENT_BATCH_SIZE=100
ENRICHMENT_PROGRESS_INTERVAL=50
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_REQUEST_DELAY_SECONDS=4
OVERPASS_SUCCESS_DELAY_SECONDS=4
OVERPASS_TIMEOUT_SECONDS=30
OVERPASS_MAX_RETRIES=3
OVERPASS_MAX_CONSECUTIVE_RATE_LIMITS=6
OVERPASS_MAX_ENDPOINT_FAILURES=2
OVERPASS_TOTAL_COORDINATE_BUCKETS=285
OVERPASS_RETRY_BACKOFF_SECONDS=2
OVERPASS_SEARCH_RADIUS_M=10000
OVERPASS_PARK_COUNT_RADIUS_M=2000
